  width: 56px;
  height: 56px;
  object-fit: contain;
}

.about-app-name {
  margin: 0 0 4px;
  font-size: 22px;
  font-weight: 700;
  color: #13294b;
}

:host-context(body.dark-theme) .about-app-name {
  color: #93c5fd;
}

.about-sector {
  margin: 0 0 10px;
  font-size: 13px;
  font-weight: 600;
  color: #1c3a66;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

:host-context(body.dark-theme) .about-sector {
  color: #93c5fd;
}

.about-location {
  margin: 0 0 16px;
  font-size: 13px;
  color: #64748b;
}

.about-description {
  margin: 0 0 14px;
  font-size: 14px;
  line-height: 1.6;
  color: #334155;
}

:host-context(body.dark-theme) .about-description {
  color: #cbd5e1;
}

.about-slogan {
  margin: 0 0 14px;
  font-size: 13.5px;
  font-style: italic;
  font-weight: 600;
  color: #13294b;
}

:host-context(body.dark-theme) .about-slogan {
  color: #93c5fd;
}

.about-phone {
  margin: 0 0 4px;
  font-size: 14px;
  font-weight: 600;
  color: #334155;
}

:host-context(body.dark-theme) .about-phone {
  color: #e2e8f0;
}

.about-version {
  margin: 0 0 24px;
  font-size: 12px;
  color: #94a3b8;
}

.about-close-action {
  width: 100%;
}

body.rtl .about-close-btn {
  right: auto;
  left: 14px;
}
