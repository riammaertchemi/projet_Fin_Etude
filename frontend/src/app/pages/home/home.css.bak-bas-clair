.home-container {
  padding: 24px;
  background-image: url('/fond-tableau-bord.jpg');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.home-container h1 {
  font-size: 24px;
  color: #1e293b;
  margin: 0 0 24px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14px;
}

@media (max-width: 1200px) {
  .stats-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 700px) {
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 460px) {
  .stats-grid {
    grid-template-columns: 1fr;
  }
}

.stat-card {
  position: relative;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 4px 14px rgba(0,0,0,0.1);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  min-width: 0;
  min-height: 230px;
}

.stat-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 24px rgba(0,0,0,0.16);
}

.stat-card.products {
  background: linear-gradient(135deg, #6366f1, #4f46e5);
}

.stat-card.categories {
  background: linear-gradient(135deg, #14b8a6, #0d9488);
}

.stat-card.suppliers {
  background: linear-gradient(135deg, #f59e0b, #d97706);
}

.stat-card.movements {
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
}

.stat-card.alerts {
  background: linear-gradient(135deg, #f43f5e, #e11d48);
}

.stat-card-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  text-decoration: none;
  color: white;
  padding: 20px 12px 16px;
}


.stat-value {
  font-size: 26px;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 5px;
}

.stat-label {
  font-size: 12.5px;
  font-weight: 500;
  opacity: 0.95;
  white-space: nowrap;
}

.stat-search {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 10px 12px;
  background: rgba(0,0,0,0.15);
  margin-top: 18px;
}

.stat-search input {
  flex: 1;
  min-width: 0;
  border: none;
  border-radius: 7px;
  padding: 7px 9px;
  font-size: 12px;
  outline: none;
}

.stat-search button {
  flex-shrink: 0;
  border: none;
  border-radius: 7px;
  width: 30px;
  height: 30px;
  background: rgba(255,255,255,0.9);
  cursor: pointer;
  font-size: 12px;
  transition: background 0.2s;
}

.stat-search button:hover {
  background: white;
}

:host-context(body.dark-theme) .home-container h1 {
  color: #f1f5f9;
}

.dashboard-header {
  margin-bottom: 24px;
}

.dashboard-eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-size: 12px;
  font-weight: 600;
  color: #64748b;
  margin: 0 0 6px;
}

.dashboard-header h1 {
  font-size: 26px;
  color: #1e293b;
  margin: 0 0 4px;
}

.dashboard-date {
  font-size: 14px;
  color: #94a3b8;
  margin: 0;
}

:host-context(body.dark-theme) .dashboard-header h1 {
  color: #f1f5f9;
}

:host-context(body.dark-theme) .dashboard-date {
  color: #64748b;
}


.stat-card-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
}

.stat-card-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.stat-card.products .stat-card-overlay {
  background: linear-gradient(180deg, rgba(99,102,241,0) 0%, rgba(99,102,241,0) 60%, rgba(79,70,229,0.92) 100%);
}

.stat-card.categories .stat-card-overlay {
  background: linear-gradient(180deg, rgba(20,184,166,0) 0%, rgba(20,184,166,0) 60%, rgba(13,148,136,0.92) 100%);
}

.stat-card.suppliers .stat-card-overlay {
  background: linear-gradient(180deg, rgba(245,158,11,0) 0%, rgba(245,158,11,0) 60%, rgba(217,119,6,0.92) 100%);
}

.stat-card.movements .stat-card-overlay {
  background: linear-gradient(180deg, rgba(139,92,246,0) 0%, rgba(139,92,246,0) 60%, rgba(124,58,237,0.92) 100%);
}

.stat-card.alerts .stat-card-overlay {
  background: linear-gradient(180deg, rgba(244,63,94,0) 0%, rgba(244,63,94,0) 60%, rgba(225,29,72,0.92) 100%);
}

.stat-card-link,
.stat-search {
  position: relative;
  z-index: 2;
}