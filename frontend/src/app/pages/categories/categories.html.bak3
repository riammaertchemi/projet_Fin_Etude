<div class="categories-page">
  <div class="page-header">
    <h1>Catégories</h1>
    <div class="header-actions no-print">
      <button class="btn-secondary" (click)="printPage()">🖨️ Imprimer</button>
      @if (canManage) {
        <button class="btn-primary" (click)="openCreateForm()">+ Nouvelle catégorie</button>
      }
    </div>
  </div>

  <div class="search-bar no-print">
    <input type="text" [(ngModel)]="searchTerm" placeholder="Rechercher une catégorie...">
    @if (searchTerm) {
      <button class="btn-clear" (click)="clearSearch()">✕ Effacer</button>
    }
  </div>

  @if (loading) {
    <p>Chargement...</p>
  }

  @if (error) {
    <p class="error">{{ error }}</p>
  }

  @if (showForm) {
    <div class="form-overlay no-print">
      <div class="form-card">
        <h2>{{ editingCategory ? 'Modifier la catégorie' : 'Nouvelle catégorie' }}</h2>
        <label>Nom</label>
        <input type="text" [(ngModel)]="newCategoryName" placeholder="Nom de la catégorie">
        <div class="form-actions">
          <button class="btn-secondary" (click)="cancelForm()">Annuler</button>
          <button class="btn-primary" (click)="saveCategory()">{{ editingCategory ? 'Mettre à jour' : 'Enregistrer' }}</button>
        </div>
      </div>
    </div>
  }

  @if (!loading && !error) {
    @if (filteredCategories.length === 0) {
      <p>Aucune catégorie trouvée{{ searchTerm ? ' pour "' + searchTerm + '"' : '' }}.</p>
    } @else {
      <table>
        <thead>
          <tr>
            <th>N°</th>
            <th>Nom</th>
            <th>Nombre de produits</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          @for (category of filteredCategories; track category.id; let i = $index) {
            <tr>
              <td>{{ i + 1 }}</td>
              <td>{{ category.name }}</td>
              <td>{{ category.products?.length || 0 }}</td>
              <td class="actions">
                @if (canManage) {
                  <button class="btn-edit" (click)="openEditForm(category)">Modifier</button>
                  <button class="btn-delete" (click)="deleteCategory(category)">Supprimer</button>
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    }
  }
</div>

