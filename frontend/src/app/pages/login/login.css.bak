.login-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4f5f7;
  font-family: system-ui, -apple-system, sans-serif;
}

.login-card {
  background: white;
  padding: 40px;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  width: 100%;
  max-width: 380px;
}

.login-logo {
  display: block;
  margin: 0 auto 8px;
  max-width: 220px;
  width: 100%;
  height: auto;
}

.subtitle {
  text-align: center;
  color: #888;
  margin-bottom: 28px;
}

.form-group {
  margin-bottom: 18px;
}

label {
  display: block;
  margin-bottom: 6px;
  font-size: 14px;
  font-weight: 500;
  color: #333;
}

input {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid #ddd;
  border-radius: 8px;
  font-size: 15px;
  box-sizing: border-box;
}

input:focus {
  outline: none;
  border-color: #4f46e5;
}

button {
  width: 100%;
  padding: 12px;
  background: #4f46e5;
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  margin-top: 8px;
}

button:disabled {
  background: #a5a5f5;
  cursor: not-allowed;
}

.error {
  color: #dc2626;
  font-size: 14px;
  margin: 8px 0;
}
/* ===================== Amelioration visuelle - style "exemple" ===================== */
:host ::ng-deep input[type="email"],
:host ::ng-deep input[type="password"],
:host ::ng-deep input[type="text"] {
  background-color: #EAF0FE !important;
  border: none !important;
  border-radius: 10px !important;
  padding: 12px 14px !important;
  font-size: 15px !important;
  color: #1e293b !important;
  box-shadow: none !important;
}

:host ::ng-deep input[type="email"]:focus,
:host ::ng-deep input[type="password"]:focus,
:host ::ng-deep input[type="text"]:focus {
  outline: none !important;
  box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.18) !important;
}

:host ::ng-deep input[type="email"]::placeholder,
:host ::ng-deep input[type="password"]::placeholder {
  color: #94a3b8 !important;
}

:host ::ng-deep button[type="submit"] {
  background: #4F46E5 !important;
  background-image: none !important;
  border: none !important;
  border-radius: 10px !important;
  padding: 13px 16px !important;
  font-size: 15px !important;
  font-weight: 700 !important;
  color: #ffffff !important;
  transition: background 0.2s ease !important;
}

:host ::ng-deep button[type="submit"]:hover {
  background: #4338CA !important;
}

/* Case "Se souvenir de moi" et lien "Mot de passe oublie ?" : conserves,
   juste allege pour rester coherent avec le nouveau style. */
:host ::ng-deep .form-check-label,
:host ::ng-deep a {
  font-size: 13.5px !important;
  color: #64748b !important;
}

:host-context(body.dark-theme) :host ::ng-deep input[type="email"],
:host-context(body.dark-theme) :host ::ng-deep input[type="password"],
:host-context(body.dark-theme) :host ::ng-deep input[type="text"] {
  background-color: #1e2740 !important;
  color: #f1f5f9 !important;
}

:host-context(body.dark-theme) :host ::ng-deep input[type="email"]::placeholder,
:host-context(body.dark-theme) :host ::ng-deep input[type="password"]::placeholder {
  color: #64748b !important;
}
/* ===================================================================================== */
