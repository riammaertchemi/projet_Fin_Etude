<div class="products-page">
  <div class="page-header">
    <h1>{{ 'products.title' | translate }}</h1>
    <div class="header-actions no-print">
      <button class="btn-secondary" (click)="printPage()">🖨️ {{ 'common.print' | translate }}</button>
      @if (canManage) {
        <button class="btn-primary" (click)="openCreateForm()">{{ 'products.newProduct' | translate }}</button>
      }
    </div>
  </div>

  <div class="search-bar no-print">
    <input type="text" [(ngModel)]="searchTerm" [placeholder]="'products.searchPlaceholder' | translate">
    @if (searchTerm) {
      <button class="btn-clear" (click)="clearSearch()">✕ {{ 'common.clear' | translate }}</button>
    }
  </div>

  @if (loading) {
    <p>{{ 'common.loading' | translate }}</p>
  }

  @if (error) {
    <p class="error">{{ error }}</p>
  }

  @if (showForm) {
    <div class="form-overlay no-print">
      <div class="form-card">
        <h2>{{ editingProduct ? ('products.formTitleEdit' | translate) : ('products.formTitleNew' | translate) }}</h2>

        @if (saveError) {
          <p class="error">{{ saveError }}</p>
        }

        <label>{{ 'products.name' | translate }}</label>
        <input type="text" [(ngModel)]="formData.name" [placeholder]="'products.name' | translate">

        <label>{{ 'products.sku' | translate }}</label>
        <input type="text" [(ngModel)]="formData.sku" [placeholder]="'products.skuPlaceholder' | translate">

        <label>{{ 'products.description' | translate }}</label>
        <textarea [(ngModel)]="formData.description" [placeholder]="'products.description' | translate"></textarea>

        <label>{{ 'products.imageLabel' | translate }}</label>
        <input type="file" accept="image/*" (change)="onImageSelected($event)">
        @if (formData.imageUrl) {
          <div class="image-preview">
            <img [src]="formData.imageUrl" alt="Aperçu">
            <button type="button" class="btn-clear" (click)="removeImage()">{{ 'products.removeImage' | translate }}</button>
          </div>
        }

        <label>{{ 'products.priceLabel' | translate }}</label>
        <input type="number" [(ngModel)]="formData.price">

        <label>{{ 'products.quantityLabel' | translate }}</label>
        <input type="number" [(ngModel)]="formData.quantity">

        <label>{{ 'products.minQuantityLabel' | translate }}</label>
        <input type="number" [(ngModel)]="formData.minQuantity">

        <label>{{ 'products.categoryLabel' | translate }}</label>
        <select [(ngModel)]="formData.categoryId">
          <option [ngValue]="null">{{ 'products.categoryNone' | translate }}</option>
          @for (category of categories; track category.id) {
            <option [ngValue]="category.id">{{ category.name }}</option>
          }
        </select>

        <label>{{ 'products.supplierLabel' | translate }}</label>
        <select [(ngModel)]="formData.supplierId">
          <option [ngValue]="null">{{ 'products.supplierNone' | translate }}</option>
          @for (supplier of suppliers; track supplier.id) {
            <option [ngValue]="supplier.id">{{ supplier.name }}</option>
          }
        </select>

        <div class="form-actions">
          <button class="btn-secondary" (click)="cancelForm()">{{ 'common.cancel' | translate }}</button>
          <button class="btn-primary" (click)="saveProduct()">{{ 'common.save' | translate }}</button>
        </div>
      </div>
    </div>
  }

  @if (!loading && !error) {
    @if (filteredProducts.length === 0) {
      <p>{{ 'products.notFound' | translate }}{{ searchTerm ? ' ' + ('common.forSearch' | translate) + ' "' + searchTerm + '"' : '' }}.</p>
    } @else {
      <table>
        <thead>
          <tr>
            <th>{{ 'products.colImage' | translate }}</th>
            <th>{{ 'products.colName' | translate }}</th>
            <th>{{ 'products.colSku' | translate }}</th>
            <th>{{ 'products.colPrice' | translate }}</th>
            <th>{{ 'products.colQuantity' | translate }}</th>
            <th>{{ 'products.colCategory' | translate }}</th>
            @if (canManage) {
              <th>{{ 'common.actions' | translate }}</th>
            }
          </tr>
        </thead>
        <tbody>
          @for (product of filteredProducts; track product.id) {
            <tr [class.low-stock]="product.quantity < product.minQuantity">
              <td>
                @if (product.imageUrl) {
                  <img [src]="product.imageUrl" alt="{{ product.name }}" class="product-thumb">
                } @else {
                  <div class="product-thumb-placeholder">📦</div>
                }
              </td>
              <td>{{ product.name }}</td>
              <td>{{ product.sku }}</td>
              <td>{{ formatPrice(product.price) }}</td>
              <td>{{ product.quantity }}</td>
              <td>{{ product.category?.name || '-' }}</td>
              @if (canManage) {
                <td class="actions">
                  <button class="btn-edit" (click)="openEditForm(product)">✏️ {{ 'common.edit' | translate }}</button>
                  <button class="btn-delete" (click)="deleteProduct(product)">🗑️ {{ 'common.delete' | translate }}</button>
                </td>
              }
            </tr>
          }
        </tbody>
      </table>
    }
  }
</div>
